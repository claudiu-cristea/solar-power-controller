#!/usr/bin/env php
<?php

/**
 * @file
 * CLI executable.
 *
 * Usage:
 *   ./bin/solar-relay
 *
 * Configuration:
 *   Copy the example.config.yml.dist to config.yml and edit the values to match
 *   your inverter setup.
 */

declare(strict_types=1);

use Monolog\Formatter\LineFormatter;
use Monolog\Handler\StreamHandler;
use Monolog\Level;
use Monolog\Logger;
use SolarRelay\Config;
use SolarRelay\Controller;

require_once __DIR__ . '/../vendor/autoload.php';

$config = Config::fromFile(__DIR__ . '/../config.yml');

$formatter = new LineFormatter("%datetime% %level_name%: %message%\n", 'Y-m-d H:i');
$defaultPushHandler = new StreamHandler($config->getDefaultLoggerStream(), Level::Info)
    ->setFormatter($formatter);
$errorPushHandler = new StreamHandler($config->getErrorLoggerStream(), Level::Warning)
    ->setFormatter($formatter);

$logger = new Logger('solar_power_controller')
    ->pushHandler($defaultPushHandler)
    ->pushHandler($errorPushHandler);

new Controller(config: $config, logger: $logger)->run();
