{
    "name": "claudiu-cristea/solar-power-controller",
    "description": "Reads the live power from a Huawei SUN2000 inverter via Modbus TCP (SDongle on your LAN).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Claudiu Cristea",
            "email": "clau.cristea@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "monolog/monolog": "^3.10",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "SolarPowerController\\": "src"
        }
    },
    "config": {
        "sort-packages": true
    }
}
