{
    "name": "claudiu-cristea/solar-relay",
    "description": "Reads the live power from an inverter that supports Modbus/TCP API and turns ON or OFF a list of configured relays, depending on whether the measured produced power is between the configured thresholds.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Claudiu Cristea",
            "email": "clau.cristea@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "monolog/monolog": "^3.10",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "SolarRelay\\": "src"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
